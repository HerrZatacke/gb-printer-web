{
  "name": "gb-printer-web-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "scripts": {
    "dev": "concurrently \"pnpm --filter gb-printer-schemas dev\" \"pnpm --filter gb-printer-web dev\"",
    "build": "pnpm --filter gb-printer-schemas build && pnpm --filter gb-printer-web build",
    "lint:fix": "pnpm -r lint:fix",
    "audit": "pnpm audit --fix=update",
    "checkupdates": "pnpm dlx npm-check-updates --workspaces --root",
    "browserlist": "pnpm dlx update-browserslist-db@latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5"
  },
  "browserslist": [
    ">1%",
    "last 4 versions",
    "Firefox ESR",
    "not dead",
    "not kaios <= 3.1",
    "not op_mini all"
  ]
}
