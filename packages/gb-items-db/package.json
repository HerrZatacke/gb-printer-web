{
  "name": "gb-items-db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "concurrently \"tsx watch src/index.ts\" \"tsc-alias --watch\"",
    "lint": "eslint .",
    "drizzle:generate": "npx drizzle-kit generate --config drizzle.config.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/autoload": "catalog:",
    "@fastify/cors": "catalog:",
    "@fastify/static": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "better-sqlite3":  "catalog:",
    "drizzle-kit":  "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "gb-image-decoder": "catalog:",
    "gb-items-source": "workspace:*",
    "gb-palettes": "catalog:",
    "gb-printer-schemas": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "concurrently": "catalog:",
    "tsc-alias": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
