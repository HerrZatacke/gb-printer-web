{
  "name": "gb-printer-web",
  "version": "1.57.13",
  "description": "GameBoy Camera Gallery WebApp",
  "scripts": {
    "dev": "pnpm dev:clean && pnpm dev:dev",
    "dev:clean": "rimraf .next",
    "dev:dev": "next dev",
    "build": "pnpm build:lint && pnpm build:clean && pnpm build:build && pnpm build:replace",
    "lint:fix": "eslint . --fix",
    "build:lint": "eslint .",
    "build:build": "next build",
    "build:clean": "rimraf .next && rimraf public/fav && rimraf out && rimraf o",
    "build:replace": "tsx scripts/replaceInFiles.ts",
    "serve": "pnpm build && pnpm serve:serve",
    "serve:serve": "pnpm dlx serve out",
    "translations:compare": "tsx scripts/compareLangFiles.ts",
    "translations:get": "tsx --env-file=.env scripts/translations/get.ts && pnpm translations:compare",
    "translations:put": "tsx --env-file=.env scripts/translations/put.ts"
  },
  "author": "Herr Zatacke",
  "license": "MIT",
  "respository": {
    "type": "git",
    "url": "https://github.com/HerrZatacke/gb-printer-web.git"
  },
